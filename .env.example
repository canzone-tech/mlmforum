# LOCAL INTEGRATION TEST ONLY; NOT production settings.
DATABASE_URL=mysql://mlmforum:local-test-only-password@127.0.0.1:33067/mlmforum_test
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:32123
API_HOST=127.0.0.1
API_PORT=4000
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
JWT_ACCESS_SECRET=local-access-change-this-secret-to-a-unique-random-value
JWT_REFRESH_SECRET=local-refresh-change-this-secret-to-a-different-value
# Production default is false until approved versioned privacy notice/verification.
REGISTRATION_INTAKE_ENABLED=true
CONSENT_POLICY_VERSION=REQUIRES_APPROVED_POLICY
NEXT_PUBLIC_API_BASE_URL=/api

# Higher budget only for repeatable isolated CI/local integration tests; production default is 5.
AUTH_LOGIN_RATE_LIMIT=30
