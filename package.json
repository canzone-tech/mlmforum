{
  "name": "mlmforum",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "bash scripts/verify.sh",
    "verify:backend": "bash scripts/verify-backend.sh",
    "verify:frontend": "bash scripts/verify-frontend.sh",
    "smoke": "node scripts/smoke.mjs",
    "api:generate": "npm run db:generate -w @mlmforum/api",
    "api:migrate": "npm run db:migrate -w @mlmforum/api",
    "api:build": "npm run build -w @mlmforum/api",
    "api:test": "npm run test:integration -w @mlmforum/api"
  },
  "dependencies": {
    "next": "15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3",
    "eslint": "9.38.0",
    "@eslint/js": "9.38.0",
    "typescript-eslint": "8.46.2",
    "globals": "16.4.0",
    "@playwright/test": "1.55.1"
  }
}
